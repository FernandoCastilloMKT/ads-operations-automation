# Copia este archivo como .env y completa los valores solo en tu PC.
# Nunca subas .env a GitHub.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Microsoft Advertising API. Los secretos reales van solo en .env.
MICROSOFT_ADS_DEVELOPER_TOKEN=
# OAuth Google independiente y obligatorio para Microsoft Ads. No reutilizar
# GOOGLE_ADS_CLIENT_ID/GOOGLE_ADS_CLIENT_SECRET.
MICROSOFT_ADS_GOOGLE_CLIENT_ID=
MICROSOFT_ADS_GOOGLE_CLIENT_SECRET=
MICROSOFT_ADS_GOOGLE_REFRESH_TOKEN=
MICROSOFT_ADS_IDENTITY_PROVIDER=Google
# Variables antiguas de Entra, conservadas solo por compatibilidad documental.
MICROSOFT_ADS_CLIENT_ID=
MICROSOFT_ADS_CLIENT_SECRET=
MICROSOFT_ADS_REFRESH_TOKEN=
MICROSOFT_ADS_TENANT_ID=common
MICROSOFT_ADS_MANAGER_ACCOUNT_NUMBER=

# Meta Marketing API. Los secretos reales van solo en .env.
META_ADS_APP_ID=
META_ADS_APP_SECRET=
META_ADS_ACCESS_TOKEN=
# Version fijada para evitar cambios inesperados de la API.
META_ADS_API_VERSION=v25.0

# Opcionales: los scripts ya tienen valores predeterminados.
ACTUALIZAR_CONSUMOS_MODO=completo
QUICK_LOOKBACK_DAYS=7
GOOGLE_ADS_PARALLEL_WORKERS=6

# Opcional: Calendar IDs separados por coma. Si queda vacio, el verificador
# conserva compatibilidad y revisa todos los calendarios legibles.
GOOGLE_CALENDAR_IDS=
# Rutas opcionales. Si se omiten, se usan los JSON privados de la raiz.
ADS_AUTOMATION_CONSUMPTION_CONFIG_PATH=
ADS_AUTOMATION_SEM_CONFIG_PATH=
